<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Cards: flat, hairline border, generous radius -->
    <style name="Widget.HingeBot.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.HingeBot.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_bg_brand</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="iconTint">@color/btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="Widget.HingeBot.Button.Green">
        <item name="backgroundTint">@color/btn_bg_green</item>
    </style>

    <style name="Widget.HingeBot.Button.Amber">
        <item name="backgroundTint">@color/btn_bg_amber</item>
    </style>

    <style name="Widget.HingeBot.Button.Red">
        <item name="backgroundTint">@color/btn_bg_red</item>
    </style>

    <style name="Widget.HingeBot.Button.Tonal">
        <item name="backgroundTint">@color/btn_bg_tonal</item>
        <item name="android:textColor">@color/btn_text_tonal</item>
        <item name="iconTint">@color/btn_text_tonal</item>
    </style>

    <style name="Widget.HingeBot.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/btn_stroke_outlined</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/btn_text_outlined</item>
        <item name="iconTint">@color/btn_text_outlined</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- Text -->
    <style name="TextAppearance.HingeBot.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.HingeBot.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <style name="TextAppearance.HingeBot.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
